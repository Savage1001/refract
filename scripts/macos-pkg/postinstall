#!/bin/sh
set -eu
umask 022

if [ "${3:-}" != "/" ]; then
  echo "Refract must be installed on the startup disk." >&2
  exit 1
fi

bundle=/Applications/Refract.app/Contents
exec /usr/bin/env -i PATH=/usr/bin:/bin HOME=/var/root ELECTRON_RUN_AS_NODE=1 \
  "$bundle/MacOS/Refract" "$bundle/Resources/app/build/scripts/install-dependencies.cjs"
