import test = require('node:test');
import assert = require('node:assert/strict');
import fs = require('node:fs/promises');
import os = require('node:os');
import path = require('node:path');
import playwright = require('playwright');
const electron=playwright._electron;

test('live find retains focus, reveals distant matches, wraps and handles shortcuts', {timeout:60000}, async t=>{
 const data=await fs.mkdtemp(path.join(os.tmpdir(),'refract-find-'));
 const env:NodeJS.ProcessEnv={...process.env,REFRACT_DATA_DIR:data,REFRACT_TEST_HIDDEN:'1'};delete env.ELECTRON_RUN_AS_NODE;
 const app=await electron.launch({args:[path.resolve(__dirname,'../..')],env});
 t.after(async()=>{await app.close();await fs.rm(data,{recursive:true,force:true,maxRetries:5,retryDelay:200});});
 const page=await app.firstWindow();await page.locator('#new').click();
 const source=page.locator('#source'),query=page.getByLabel('Find in file'),status=page.locator('.editor-find [role=status]');
 await source.fill('needle first\n'+'line\n'.repeat(200)+'\t'+'x'.repeat(200)+' needle last');
 await source.evaluate(el=>{el.focus();(el as HTMLTextAreaElement).setSelectionRange(0,0);});
 await source.press('Control+f');await query.fill('needle');
 assert.equal(await status.textContent(),'1 / 2');assert.equal(await query.evaluate(el=>el===document.activeElement),true);
 await query.press('Enter');assert.equal(await status.textContent(),'2 / 2');
 assert.equal(await query.evaluate(el=>el===document.activeElement),true);
 const scroll=await source.evaluate(el=>({top:el.scrollTop,left:el.scrollLeft}));assert.ok(scroll.top>1000);assert.ok(scroll.left>0);
 await page.getByLabel('Wrap search').uncheck();await query.press('Enter');assert.equal(await status.textContent(),'End of file');
 await page.getByLabel('Wrap search').check();await query.press('Enter');assert.equal(await status.textContent(),'1 / 2');
 await query.press('Shift+Enter');assert.equal(await status.textContent(),'2 / 2');
 await query.dispatchEvent('compositionstart');await query.fill('need');
 assert.equal(await status.textContent(),'2 / 2');await query.dispatchEvent('compositionend');
 assert.equal(await status.textContent(),'1 / 2');
 await query.fill('missing');assert.equal(await status.textContent(),'No matches');
 await query.fill('');assert.equal(await status.textContent(),'Type to search');
 await query.fill('needle');await query.press('Escape');assert.equal(await page.locator('.editor-find').isHidden(),true);
 await source.press('Control+f');assert.equal(await query.inputValue(),'needle');
 await query.press('F3');assert.equal(await status.textContent(),'2 / 2');
 await page.getByLabel('Replace with').fill('$1');await page.getByLabel('Replace with').press('Enter');
 assert.ok((await source.inputValue()).endsWith('$1 last'));
 await query.press('Escape');await source.press('Control+z');assert.ok((await source.inputValue()).endsWith('needle last'));
 await source.press('Control+f');await query.press('Escape');
 await source.evaluate(el=>{el.focus();(el as HTMLTextAreaElement).setSelectionRange(7,12);});await source.press('Control+f');assert.equal(await query.inputValue(),'first');
 assert.equal(await status.textContent(),'1 / 1');
 const [id]=(await fs.readdir(path.join(data,'projects'))).filter((name:string)=>/^[0-9a-f-]{36}$/.test(name));
 await fs.writeFile(path.join(data,'projects',id,'other.tex'),'first first first');
 await page.locator('#home').click();assert.equal(await page.locator('.editor-find').isHidden(),true);
 await page.locator('#list article').first().click();await source.waitFor({state:'visible'});
 await source.press('Control+f');await query.fill('first');
 await page.locator('#file-list [title="other.tex"]').click();assert.equal(await status.textContent(),'1 / 3');
 await source.evaluate(el=>{(el as HTMLTextAreaElement).readOnly=true;});
 await page.getByRole('button',{name:'All',exact:true}).click();assert.equal(await source.inputValue(),'first first first');
});
